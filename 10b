Create test/widget_test.dart and paste the following code.

dart

import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:flutter_lab/main.dart';

void main() {
  testWidgets('Initial counter value is zero',
      (WidgetTester tester) async {
    await tester.pumpWidget(const MyApp());

    expect(find.text('0'), findsOneWidget);
  });

  testWidgets('Increment button increases count',
      (WidgetTester tester) async {
    await tester.pumpWidget(const MyApp());

    await tester.tap(find.byKey(const Key('incrementButton')));
    await tester.pump();

    expect(find.text('1'), findsOneWidget);
  });

  testWidgets('Decrement button decreases count',
      (WidgetTester tester) async {
    await tester.pumpWidget(const MyApp());

    await tester.tap(find.byKey(const Key('decrementButton')));
    await tester.pump();

    expect(find.text('-1'), findsOneWidget);
  });
}
